*.bedgraph

# --- analysis clutter / temporary dirs ---
analysis/_trash/
analysis/_archive/
analysis/clean/

# keep text tables, ignore office files
analysis/**/*.xlsx
analysis/**/*.docx

# --- OS/editor junk ---
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/
__pycache__/
*.pyc
*:Zone.Identifier

# --- keep GitHub clean: ignore archive/intermediate analysis dirs ---
analysis/_archive/
analysis/intermediates_exp/
analysis/db/
analysis/**/*.bed
